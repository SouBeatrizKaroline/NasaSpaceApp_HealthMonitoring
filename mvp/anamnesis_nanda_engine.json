{
  "version": "1.0.0",
  "project": "AstroCare-Q",
  "clinical_rules": [
    {
      "id": "RULE_SANS_01",
      "nasa_hazard": "Altered Gravity Fields",
      "body_zone": "head_neuro_ocular",
      "anamnesis_triggers": ["blurred_vision", "morning_headache", "ocular_pressure"],
      "multimodal_inputs": ["facial_edema_photo", "amsler_grid_test"],
      "nanda_diagnosis": {
        "code": "00204",
        "label": "Ineffective peripheral tissue perfusion / Neuro-ocular risk"
      },
      "medical_hypothesis": "Suspected SANS (Spaceflight Associated Neuro-ocular Syndrome)",
      "severity": "red",
      "immediate_action": "Perform Amsler grid visual test, reduce sodium intake, and transmit SOAP summary to Flight Surgeon."
    },
    {
      "id": "RULE_SLEEP_02",
      "nasa_hazard": "Isolation and Confinement",
      "body_zone": "head_neuro_ocular",
      "anamnesis_triggers": ["insomnia", "irritability", "cognitive_fatigue"],
      "multimodal_inputs": ["slow_vocal_cadence", "sleep_hours_under_5"],
      "nanda_diagnosis": {
        "code": "00198",
        "label": "Disturbed sleep pattern"
      },
      "medical_hypothesis": "Sleep deprivation / Cabin circadian misalignment",
      "severity": "amber",
      "immediate_action": "Switch cabin lighting to warm spectrum, run 4-7-8 breathing protocol, and adjust rest schedule."
    },
    {
      "id": "RULE_RAD_SKIN_03",
      "nasa_hazard": "Space Radiation",
      "body_zone": "skin_immune",
      "anamnesis_triggers": ["erythema", "pruritus", "post_eva_fatigue"],
      "multimodal_inputs": ["skin_lesion_photo", "high_quantum_dosimeter_reading"],
      "nanda_diagnosis": {
        "code": "00046",
        "label": "Impaired skin integrity"
      },
      "medical_hypothesis": "Acute skin reaction or elevated cumulative radiation exposure",
      "severity": "red",
      "immediate_action": "Relocate to shielded spacecraft module, apply moisturizing barrier, and capture follow-up photo in 12h."
    },
    {
      "id": "RULE_CARDIO_HYDRATION_04",
      "nasa_hazard": "Hostile Closed Environments",
      "body_zone": "thorax_cardio",
      "anamnesis_triggers": ["dizziness", "palpitations", "intense_thirst"],
      "multimodal_inputs": ["video_rppg_elevated_hr", "low_blood_pressure"],
      "nanda_diagnosis": {
        "code": "00027",
        "label": "Deficient fluid volume"
      },
      "medical_hypothesis": "Dehydration or orthostatic intolerance",
      "severity": "amber",
      "immediate_action": "Consume 500mL electrolyte solution in small sips and repeat webcam rPPG pulse check in 30 minutes."
    }
  ]
}
